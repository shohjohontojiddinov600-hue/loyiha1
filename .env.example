# SMART MARKET PLATFORMA SOZLAMALARI VA INTEGRATSIYALAR (.env)

# Server
PORT=3000
NODE_ENV=production
APP_URL=https://smartmarket.uz

# PostgreSQL Database
DATABASE_URL="postgresql://smart_user:SecretPassword123@localhost:5432/smart_market_db?schema=public"

# Redis Cache & Sessions
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Xavfsizlik
JWT_SECRET=super_secret_jwt_key_2026_smart_market
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 1. To'lov tizimlari (Payment Gateways)
# Payme
PAYME_MERCHANT_ID=64a1234567890abcdef
PAYME_SECRET_KEY=payme_secret_key_prod_or_test
# Click
CLICK_SERVICE_ID=12345
CLICK_MERCHANT_ID=67890
CLICK_SECRET_KEY=click_secret_key_prod_or_test
# Uzum Bank
UZUM_MERCHANT_ID=uzum_merchant_id_val

# 2. Xarita va Logistika (Maps & Logistics)
YANDEX_MAPS_API_KEY=yandex_maps_api_key_sample
GOOGLE_MAPS_API_KEY=google_maps_api_key_sample
YANDEX_GO_DELIVERY_TOKEN=yandex_go_delivery_bearer_token

# 3. Bildirishnomalar (SMS & Telegram)
ESKIZ_SMS_EMAIL=admin@smartmarket.uz
ESKIZ_SMS_PASSWORD=eskiz_password
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_ID=-100123456789

# 4. Soliq va Fiskalizatsiya (DSQ / OFD)
OFD_COMPANY_INN=123456789
OFD_API_URL=https://ofd.soliq.uz/api/v1
OFD_API_TOKEN=ofd_bearer_token_fiscal

